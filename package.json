{
  "name": "remote-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first remote control for a local Codex app-server",
  "scripts": {
    "start": "node src/server.mjs",
    "lan": "node src/server.mjs --lan",
    "remote": "node src/server.mjs --remote",
    "codex": "node src/server.mjs --agent codex",
    "antigravity": "node src/server.mjs --agent antigravity",
    "test": "node --test",
    "check": "npm test && node --check src/server.mjs && node --check public/app.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}

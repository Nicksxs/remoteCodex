{
  "name": "remote-codex",
  "version": "0.2.0",
  "type": "module",
  "description": "Zero-dependency mobile PWA remote control for local Codex and Antigravity agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nicksxs/remoteCodex.git"
  },
  "homepage": "https://github.com/Nicksxs/remoteCodex",
  "bugs": {
    "url": "https://github.com/Nicksxs/remoteCodex/issues"
  },
  "keywords": [
    "codex",
    "antigravity",
    "acp",
    "agent",
    "pwa",
    "remote-control",
    "cloudflare-tunnel"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "lan": "node src/server.mjs --lan",
    "remote": "node src/server.mjs --remote",
    "codex": "node src/server.mjs --agent codex",
    "antigravity": "node src/server.mjs --agent antigravity",
    "test": "node --test",
    "check": "npm test && node --check src/server.mjs && node --check public/app.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
